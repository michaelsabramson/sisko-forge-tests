+    // ---- test hook (speed): token grouping for AI combat planning ----
+    // While the AI plans blocks the board doesn't change, and identical tokens (same name, controller, power,
+    // toughness, keywords, counters, damage, tapped/sick status, no attachments or changed characteristics,
+    // not referenced by any effect) get identical answers from canBlock as long as neither card is involved in
+    // combat yet and no block has been assigned since. Remember those answers per group pair.
+    private static final class BlockMemo {
+        int depth;
+        java.util.Set<Card> referenced;
+        final Map<Card, String> keys = new java.util.IdentityHashMap<>();
+        final Map<String, Boolean> answers = new HashMap<>();
+        Combat combat;
+        long blockersSig;
+        Game game;
+        CardCollectionView staticCards;
+        boolean buildingStatic;
+        final Map<Combat, long[]> lure = new java.util.IdentityHashMap<>();   // combat -> {attackersSig, anyLure}
+    }
+
+    /** While the AI plans (board frozen), the cards in the static-ability zones are gathered once instead of per check. */
+    public static CardCollectionView frozenStaticZoneCards(final Game g) {
+        final BlockMemo m = blockMemo.get();
+        if (m == null || m.game != g || m.buildingStatic) return null;
+        if (m.staticCards == null) {
+            m.buildingStatic = true;
+            try { m.staticCards = g.getCardsIn(ZoneType.STATIC_ABILITIES_SOURCE_ZONES); } finally { m.buildingStatic = false; }
+        }
+        return m.staticCards;
+    }
+
+    private static boolean hasLureKeyword(final Card a) {
+        if (a.hasStartOfKeyword("All creatures able to block CARDNAME do so.")
+                || a.hasStartOfKeyword("CARDNAME must be blocked if able.")
+                || a.hasStartOfKeyword("CARDNAME must be blocked by exactly one creature if able.")
+                || a.hasStartOfKeyword("CARDNAME must be blocked by two or more creatures if able.")) return true;
+        for (final KeywordInterface inst : a.getKeywords()) if (inst.getOriginal().startsWith("MustBeBlockedBy")) return true;
+        return false;
+    }
+    /** Does any attacker in this combat carry a "must be blocked" requirement? (cached per combat while planning) */
+    private static boolean anyLure(final Combat combat) {
+        final CardCollectionView attackers = combat.getAttackers();
+        final BlockMemo m = blockMemo.get();
+        long sig = attackers.size();
+        if (m != null) {
+            for (final Card a : attackers) { long x = a.getId() * 0x9E3779B97F4A7C15L; sig += x ^ (x >>> 31); }
+            final long[] c = m.lure.get(combat);
+            if (c != null && c[0] == sig) return c[1] != 0;
+        }
+        boolean any = false;
+        for (final Card a : attackers) if (hasLureKeyword(a)) { any = true; break; }
+        if (m != null) m.lure.put(combat, new long[] { sig, any ? 1 : 0 });
+        return any;
+    }
+    private static final ThreadLocal<BlockMemo> blockMemo = new ThreadLocal<>();
+    private static final String NO_KEY = "";
+
+    public static void beginBlockMemo(final Game game) {
+        BlockMemo m = blockMemo.get();
+        if (m == null) { m = new BlockMemo(); blockMemo.set(m); }
+        if (m.depth++ == 0) {
+            m.keys.clear(); m.answers.clear(); m.combat = null; m.lure.clear(); m.staticCards = null; m.game = game;
+            final java.util.Set<Card> ref = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<>());
+            for (final Card c : game.getCardsInGame()) {
+                for (final Object o : c.getRemembered()) if (o instanceof Card) ref.add((Card) o);
+                for (final Card o : c.getImprintedCards()) ref.add(o);
+                for (final Card o : c.getEncodedCards()) ref.add(o);
+                for (final Card o : c.getAttachedCards()) ref.add(o);
+                if (c.isAttachedToEntity() && c.getEntityAttachedTo() instanceof Card) ref.add((Card) c.getEntityAttachedTo());
+            }
+            m.referenced = ref;
+        }
+    }
+    public static void endBlockMemo() {
+        final BlockMemo m = blockMemo.get();
+        if (m != null && --m.depth <= 0) blockMemo.remove();
+    }
+    private static String groupKey(final BlockMemo m, final Card c) {
+        String k = m.keys.get(c);
+        if (k != null) return k;
+        k = NO_KEY;
+        if (c.isToken() && !c.isFaceDown() && !c.isPhasedOut() && !m.referenced.contains(c)
+                && !c.isAttachedToEntity() && c.getAttachedCards().isEmpty()) {
+            final StringBuilder sb = new StringBuilder(c.getName()).append('|').append(c.getController().getId())
+                    .append('|').append(c.getOwner().getId()).append('|').append(c.getNetPower()).append('/').append(c.getNetToughness())
+                    .append('|').append(c.isTapped()).append(c.isSick()).append(c.getDamage())
+                    .append('|').append(c.getCounters()).append('|').append(c.getType()).append('|').append(c.getColor());
+            for (final KeywordInterface inst : c.getKeywords()) sb.append('|').append(inst.getOriginal());
+            // changes granted by effects: identical only if granted by the same effects (timestamp + static id)
+            sb.append("|K"); for (final com.google.common.collect.Table.Cell<Long, Long, ?> x : c.getChangedCardKeywords().cellSet()) sb.append(x.getRowKey()).append(':').append(x.getColumnKey()).append(',');
+            sb.append("|T"); for (final com.google.common.collect.Table.Cell<Long, Long, ?> x : c.getChangedCardTraits().cellSet()) sb.append(x.getRowKey()).append(':').append(x.getColumnKey()).append(',');
+            sb.append("|S"); for (final forge.game.staticability.StaticAbility st : c.getStaticAbilities()) { if (st.isIntrinsic()) sb.append(st.getOriginalMapParams()); else sb.append(st.getId()); sb.append(','); }
+            k = sb.toString();
+        }
+        m.keys.put(c, k);
+        return k;
+    }
+
     public static boolean canBlock(final Card attacker, final Card blocker, final Combat combat) {
+        final BlockMemo m = blockMemo.get();
+        if (m == null || combat == null || attacker == null || blocker == null
+                || !combat.getBlockers(attacker).isEmpty() || combat.isBlocking(blocker)) {
+            return canBlockUncached(attacker, blocker, combat);
+        }
+        final String ka = groupKey(m, attacker), kb = groupKey(m, blocker);
+        if (ka == NO_KEY || kb == NO_KEY) {
+            return canBlockUncached(attacker, blocker, combat);
+        }
+        long sig = 0;
+        for (final Card b : combat.getAllBlockers()) { long x = b.getId() * 0x9E3779B97F4A7C15L; sig += x ^ (x >>> 29); }
+        if (m.combat != combat || m.blockersSig != sig) { m.answers.clear(); m.combat = combat; m.blockersSig = sig; }
+        final GameEntity def = combat.getDefenderByAttacker(attacker);
+        final String key = ka + '\u0001' + kb + '\u0001' + (def == null ? "-" : def.getId() + def.getClass().getSimpleName());
+        Boolean r = m.answers.get(key);
+        if (r == null) { r = canBlockUncached(attacker, blocker, combat); m.answers.put(key, r); }
+        return r;
+    }
+
+    private static boolean canBlockUncached(final Card attacker, final Card blocker, final Combat combat) {
         if (attacker == null || blocker == null) {
             return false;
         }
