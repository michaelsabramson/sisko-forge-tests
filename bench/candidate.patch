diff --git a/forge-ai/src/main/java/forge/ai/SmartCombat.java b/forge-ai/src/main/java/forge/ai/SmartCombat.java
new file mode 100644
index 00000000..e62f5986
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/SmartCombat.java
@@ -0,0 +1,330 @@
+package forge.ai;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+import forge.game.GameEntity;
+import forge.game.card.Card;
+import forge.game.combat.Combat;
+import forge.game.combat.CombatUtil;
+import forge.game.keyword.Keyword;
+import forge.game.player.Player;
+
+/**
+ * Testing: a multiplayer attack planner (-Dsisko.smartCombat=all, or per player via AiController.smartCombat).
+ * Decides attacks the way a real Commander player tends to, in this order:
+ *  1. lethal on any opponent, if what is left of the table can't kill us on the swing back (always on the last one);
+ *     when the threat's all-out swing would kill us and we are its easiest target: kill the threat, else throw
+ *     everything at it to shrink its attack, else take any kill there is;
+ *  a runaway leader (board power 20+, double anyone else's) gets every free attack first;
+ *  2. an open player (none of their blockers can block our spare attackers well): swing at them with the
+ *     creatures not needed at home;
+ *  3/4. otherwise only free attacks: a spare creature that no blocker of that player can kill in a block,
+ *     aimed at a runaway leader first; everything else stays home.
+ * "Safe" = after attacking, the creatures left untapped at home (plus vigilance attackers) keep the strongest
+ * single opponent's all-out attack next turn below our life.
+ * Blocking (SmartBlock, hooked into AiBlockController): always take fair trades unless the blocker is needed against the
+ * next player's swing or is precious (commander, combo piece, engine) and the attacker isn't a runaway leader's; chump only when this combat would leave us dead to that swing (Forge: a fixed life threshold).
+ * Returns false (Forge's own attack logic then runs) when the declaration would be illegal, e.g. must-attack creatures.
+ */
+public final class SmartCombat {
+    private SmartCombat() { }
+
+    static int pow(Card c) { return Math.max(0, c.getNetCombatDamage()); }
+    static int life(Card c) { return Math.max(1, c.getNetToughness() - c.getDamage()); }
+
+    /** src's combat damage alone kills dst */
+    static boolean kills(Card src, Card dst) {
+        if (pow(src) <= 0 || dst.hasKeyword(Keyword.INDESTRUCTIBLE)) return false;
+        return src.hasKeyword(Keyword.DEATHTOUCH) || pow(src) >= life(dst);
+    }
+
+    static List<Card> blockers(Player o) {
+        List<Card> out = new ArrayList<>();
+        for (Card b : o.getCreaturesInPlay()) if (CombatUtil.canBlock(b)) out.add(b);
+        return out;
+    }
+
+    /** damage that gets through if each blocker chumps the biggest attacker it can block (trample spills over) */
+    static int unblocked(List<Card> attackers, List<Card> blockers) {
+        List<Card> left = new ArrayList<>(attackers);
+        left.sort(Comparator.comparingInt(SmartCombat::pow).reversed());
+        int dmg = 0;
+        for (Card b : blockers) {
+            for (Card a : left) {
+                boolean can;
+                try { can = CombatUtil.canBlock(a, b); } catch (Throwable t) { can = true; }
+                if (can) {
+                    if (a.hasKeyword(Keyword.TRAMPLE)) dmg += Math.max(0, pow(a) - life(b));
+                    left.remove(a);
+                    break;
+                }
+            }
+        }
+        for (Card a : left) dmg += pow(a);
+        return dmg;
+    }
+
+    /** the strongest single opponent's all-out attack next turn, against what we keep untapped at home */
+    /** -Dsisko.crackback=two: guard against the two strongest opponents' swings together (default: the strongest one) */
+    static final boolean CRACK_TWO = "two".equals(System.getProperty("sisko.crackback"));
+    /** -Dsisko.doomed=false: no doomed rule (a player facing a lethal swing plays like anyone else) */
+    static final boolean DOOMED = !"false".equals(System.getProperty("sisko.doomed"));
+
+    /** -Dsisko.attackMode: smart (default: the full planner), lethal (cross-table lethal check, then Forge's own logic),
+     *  threat (the planner, with Forge's top threat getting the free attacks first instead of only a runaway leader) */
+    static final String MODE = System.getProperty("sisko.attackMode", "smart");
+
+    static boolean safe(Player me, List<Card> home, List<Player> opps) {
+        int worst = 0, second = 0;
+        for (Player q : opps) {
+            int d = unblocked(attackersOf(q), home);
+            if (d > worst) { second = worst; worst = d; } else if (d > second) second = d;
+        }
+        return !me.canLoseLife() || (CRACK_TWO ? worst + second : worst) < me.getLife();
+    }
+
+    static boolean canAttack(Card c, Player o) {
+        try { return CombatUtil.canAttack(c, o); } catch (Throwable t) { return false; }
+    }
+
+    /** an attack no blocker of o can punish: every blocker that could block it dies or bounces off without killing it */
+    static boolean free(Card a, Player o, List<Card> obl) {
+        if (!canAttack(a, o)) return false;
+        for (Card b : obl) {
+            boolean can;
+            try { can = CombatUtil.canBlock(a, b); } catch (Throwable t) { can = true; }
+            if (can && kills(b, a)) return false;
+        }
+        return true;
+    }
+
+    public static boolean declare(Player me, Combat combat) {
+        List<Player> opps = new ArrayList<>();
+        for (GameEntity d : combat.getDefenders()) if (d instanceof Player p && !p.hasLost() && p.isOpponentOf(me)) opps.add(p);
+        if (opps.isEmpty()) return false;
+        List<Card> able = new ArrayList<>();
+        for (Card c : me.getCreaturesInPlay()) {
+            boolean ok;
+            try { ok = CombatUtil.canAttack(c); } catch (Throwable t) { ok = false; }
+            if (ok && pow(c) > 0) able.add(c);
+        }
+        if (able.isEmpty()) return validOrUndo(me, combat);
+
+        // 1. lethal on anyone, if the rest of the table can't kill us back
+        opps.sort(Comparator.comparingInt(Player::getLife));
+        List<Player> killable = new ArrayList<>();
+        for (Player o : opps) {
+            if (!o.canLoseLife() || o.cantLoseForZeroOrLessLife()) continue;
+            List<Card> a = attackersFor(able, o);
+            if (a.isEmpty() || unblocked(a, blockers(o)) < o.getLife()) continue;
+            killable.add(o);
+            List<Player> rest = new ArrayList<>(opps); rest.remove(o);
+            List<Card> home = new ArrayList<>();
+            for (Card c : me.getCreaturesInPlay()) if (!a.contains(c) || c.hasKeyword(Keyword.VIGILANCE)) home.add(c);
+            if (rest.isEmpty() || safe(me, home, rest)) {
+                note(me, "lethal");
+                for (Card c : a) combat.addAttacker(c, o);
+                return validOrUndo(me, combat);
+            }
+        }
+        // doomed: even holding everything back, someone's swing next turn kills us. In order: kill the player who
+        // threatens us, else throw everything at them to shrink their attack, else take whatever kill there is.
+        // Doomed only if we are also the threat's easiest kill: its all-out swing leaves us lower than any other player it could hit.
+        Player threat = null; int worst = -1;
+        for (Player q : opps) {
+            int d = unblocked(attackersOf(q), me.getCreaturesInPlay());
+            if (d > worst) { worst = d; threat = q; }
+        }
+        if ("lethal".equals(MODE)) return false;   // no kill on: Forge's own attack logic decides
+
+        if (DOOMED && threat != null && me.canLoseLife() && worst >= me.getLife() && easiestTarget(threat, me)) {
+            if (threat != null && killable.contains(threat)) {
+                note(me, "doomed-kill-threat");
+                for (Card c : attackersFor(able, threat)) combat.addAttacker(c, threat);
+                return validOrUndo(me, combat);
+            }
+            if (threat != null && !attackersFor(able, threat).isEmpty()) {
+                note(me, "doomed-attack-threat");
+                for (Card c : attackersFor(able, threat)) combat.addAttacker(c, threat);
+                return validOrUndo(me, combat);
+            }
+            if (!killable.isEmpty()) {
+                note(me, "doomed-kill-other");
+                Player o = killable.get(0);
+                for (Card c : attackersFor(able, o)) combat.addAttacker(c, o);
+                return validOrUndo(me, combat);
+            }
+        }
+
+        // what has to stay home: keep the best blockers back until the strongest crack-back is survivable
+        List<Card> byDefence = new ArrayList<>(able);
+        byDefence.sort(Comparator.comparingInt((Card c) -> life(c) * 2 + pow(c)).reversed());
+        List<Card> home = new ArrayList<>();
+        for (Card c : me.getCreaturesInPlay()) if (!able.contains(c)) home.add(c);
+        List<Card> spare = new ArrayList<>();
+        int k = 0;
+        while (!safe(me, withVigilance(home, able), opps) && k < byDefence.size()) home.add(byDefence.get(k++));
+        if (!safe(me, withVigilance(home, able), opps)) {
+            for (Card c : able) if (c.hasKeyword(Keyword.VIGILANCE)) spare.add(c);   // under threat: only attacks that don't leave home
+        } else {
+            for (Card c : able) if (!home.contains(c) || c.hasKeyword(Keyword.VIGILANCE)) spare.add(c);
+        }
+        if (spare.isEmpty()) { note(me, "hold"); return validOrUndo(me, combat); }
+
+        // a runaway leader comes first: every spare creature with a free attack on them takes it
+        Player leader = null;
+        List<Player> byBoard = new ArrayList<>(opps);
+        byBoard.sort(Comparator.comparingInt(SmartCombat::boardPow).reversed());
+        if (byBoard.size() > 1 && boardPow(byBoard.get(0)) >= 20 && boardPow(byBoard.get(0)) >= 2 * Math.max(1, boardPow(byBoard.get(1)))) leader = byBoard.get(0);
+        if ("threat".equals(MODE) && opps.size() > 1) {   // Forge's top threat (its board score) gets the free attacks first
+            int best = Integer.MIN_VALUE;
+            for (Player o : opps) {
+                int sc;
+                try { sc = ComputerUtil.evaluateBoardPosition(me, o); } catch (Throwable t) { sc = boardPow(o); }
+                if (sc > best) { best = sc; leader = o; }
+            }
+        }
+        if (leader != null) {
+            List<Card> lb = blockers(leader), sent = new ArrayList<>();
+            for (Card c : spare) if (free(c, leader, lb)) { combat.addAttacker(c, leader); sent.add(c); }
+            if (!sent.isEmpty()) note(me, "leader");
+            spare.removeAll(sent);
+            if (spare.isEmpty()) return validOrUndo(me, combat);
+            opps.remove(leader);
+            if (opps.isEmpty()) return validOrUndo(me, combat);
+        }
+
+        // 2. an open player: every spare attacker that can reach them attacks freely
+        Player open = null; int openDmg = 0;
+        for (Player o : opps) {
+            List<Card> obl = blockers(o), a = new ArrayList<>();
+            boolean allFree = true;
+            for (Card c : spare) if (canAttack(c, o)) { a.add(c); if (!free(c, o, obl)) allFree = false; }
+            if (!allFree || a.isEmpty()) continue;
+            int d = unblocked(a, obl);
+            if (d > openDmg) { open = o; openDmg = d; }
+        }
+        if (open != null) {
+            note(me, "open");
+            for (Card c : spare) if (canAttack(c, open)) combat.addAttacker(c, open);
+            return validOrUndo(me, combat);
+        }
+
+        // 3/4. free attacks only, lowest life first (the leader was offered its free attacks above)
+        List<Player> order = new ArrayList<>(opps);   // already lowest life first
+        note(me, "free");
+        for (Card c : spare) {
+            for (Player o : order) {
+                if (free(c, o, blockers(o))) { combat.addAttacker(c, o); break; }
+            }
+        }
+        return validOrUndo(me, combat);
+    }
+
+    // ---- blocking (testing: -Dsisko.smartBlock=all, or per player via AiController.smartBlock) ----
+
+    static boolean blocks(Player p) {
+        return p.getController() instanceof PlayerControllerAi pc && pc.getAi().smartBlock;
+    }
+
+    /** the strongest single opponent's all-out swing next turn against all our creatures (they untap), other than skip */
+    static int nextSwing(Player me, Player skip, List<Card> ours) {
+        int worst = 0;
+        for (Player q : me.getGame().getPlayers()) {
+            if (q == me || q == skip || q.hasLost() || !q.isOpponentOf(me)) continue;
+            worst = Math.max(worst, unblocked(attackersOf(q), ours));
+        }
+        return worst;
+    }
+
+    /** would we be left dead to the next player's swing, with lifeAfter life once this combat is over? */
+    static boolean deadToNextSwing(Player me, int lifeAfter, Combat combat) {
+        if (!me.canLoseLife()) return false;
+        Player attacker = combat.getAttackingPlayer();
+        return lifeAfter <= nextSwing(me, attacker, me.getCreaturesInPlay());
+    }
+
+    /** is this blocker needed at home against the other opponents' swings (we'd be dead without it)? */
+    static boolean blockerNeeded(Player me, Card blocker, Player attackerCtrl) {
+        if (!me.canLoseLife()) return false;
+        List<Card> rest = new ArrayList<>(me.getCreaturesInPlay());
+        rest.remove(blocker);
+        return nextSwing(me, attackerCtrl, rest) >= me.getLife() && nextSwing(me, attackerCtrl, me.getCreaturesInPlay()) < me.getLife();
+    }
+
+    /** a creature worth more than its stats to its deck: the commander, a combo piece or payoff, or an engine
+     *  (a repeatable trigger, an effect on other permanents, or a non-mana activated ability). Not traded in a block. */
+    static boolean precious(Card c) {
+        if (c.isToken()) return false;
+        if (c.isCommander()) return true;
+        try { if (ComboShortcut.isComboPiece(c.getController(), c)) return true; } catch (Throwable t) { }
+        for (forge.game.trigger.Trigger t : c.getTriggers()) {
+            String vc = t.getParamOrDefault("ValidCard", "");
+            boolean selfOnly = vc.equals("Card.Self") && (t.getMode() == forge.game.trigger.TriggerType.ChangesZone
+                    || t.getMode() == forge.game.trigger.TriggerType.Attacks || t.getMode() == forge.game.trigger.TriggerType.DamageDone);
+            if (!selfOnly) return true;   // whenever another creature dies / you cast / at upkeep ...: an engine
+        }
+        for (forge.game.staticability.StaticAbility st : c.getStaticAbilities()) {
+            String aff = st.getParamOrDefault("Affected", st.getParamOrDefault("ValidCard", ""));
+            if (!aff.isEmpty() && !aff.equals("Card.Self")) return true;   // anthems, cost reducers, ...
+        }
+        for (forge.game.spellability.SpellAbility sa : c.getSpellAbilities()) {
+            if (sa.isActivatedAbility() && !sa.isManaAbility()) return true;
+        }
+        return false;
+    }
+
+    /** is the attacker's controller a runaway leader (board power 20+, double anyone else's)? Then precious blockers trade too. */
+    static boolean leader(Player q) {
+        int mine = boardPow(q), next = 0;
+        for (Player r : q.getGame().getPlayers()) if (r != q && !r.hasLost()) next = Math.max(next, boardPow(r));
+        return mine >= 20 && mine >= 2 * Math.max(1, next);
+    }
+
+    static List<Card> attackersOf(Player q) {
+        List<Card> att = new ArrayList<>();
+        for (Card c : q.getCreaturesInPlay()) if (pow(c) > 0 && !c.hasKeyword(Keyword.DEFENDER)) att.add(c);
+        return att;
+    }
+
+    /** would q's all-out swing leave me lower than any other player q could aim it at? */
+    static boolean easiestTarget(Player q, Player me) {
+        List<Card> att = attackersOf(q);
+        int mine = me.getLife() - unblocked(att, me.getCreaturesInPlay());
+        for (Player r : q.getGame().getPlayers()) {
+            if (r == me || r == q || r.hasLost() || !r.isOpponentOf(q)) continue;
+            if (r.getLife() - unblocked(att, r.getCreaturesInPlay()) < mine) return false;
+        }
+        return true;
+    }
+
+    static List<Card> attackersFor(List<Card> able, Player o) {
+        List<Card> a = new ArrayList<>();
+        for (Card c : able) if (canAttack(c, o)) a.add(c);
+        return a;
+    }
+
+    static final boolean LOG = Boolean.getBoolean("sisko.combatLog");
+    static void note(Player me, String kind) { if (LOG) System.out.println("SMART " + kind + " p=" + me.getName().replace(' ', '_') + " t=" + me.getGame().getPhaseHandler().getTurn()); }
+
+    static List<Card> withVigilance(List<Card> home, List<Card> able) {
+        List<Card> h = new ArrayList<>(home);
+        for (Card c : able) if (c.hasKeyword(Keyword.VIGILANCE) && !h.contains(c)) h.add(c);
+        return h;
+    }
+
+    static int boardPow(Player p) {
+        int s = 0;
+        for (Card c : p.getCreaturesInPlay()) s += pow(c);
+        return s;
+    }
+
+    static boolean validOrUndo(Player me, Combat combat) {
+        boolean ok;
+        try { ok = CombatUtil.validateAttackers(combat); } catch (Throwable t) { ok = false; }
+        if (!ok) for (Card c : new ArrayList<>(combat.getAttackers())) if (c.getController() == me) combat.removeFromCombat(c);
+        return ok;
+    }
+}
