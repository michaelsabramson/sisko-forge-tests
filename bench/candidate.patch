+                            m.put(f[0], new String[] {f[1], f[2]});
+                        }
+                    }
+                } catch (Exception e) {
+                    System.err.println("ComboShortcut: can't read " + path + ": " + e);
+                }
+            }
+            payoffs = m;
+            return m;
+        }
