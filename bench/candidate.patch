+    /** Generic pieces ("#kw:Persist", "#type:Zombie,mv<=3", "#artifact,mv=0", ...): does this card fit? */
+    private static boolean fitsTemplate(final Card c, final String template) {
+        for (String cond : template.substring(1).split(",")) {
+            if (cond.startsWith("kw:")) {
+                boolean any = false;
+                for (String kw : cond.substring(3).split("\\|")) {
+                    try {
+                        if (c.hasKeyword(forge.game.keyword.Keyword.valueOf(kw.toUpperCase()))) {
+                            any = true;
+                        }
+                    } catch (IllegalArgumentException e) {
+                        // unknown keyword
+                    }
+                }
+                if (!any) {
+                    return false;
+                }
+            } else if (cond.startsWith("type:")) {
+                boolean any = false;
+                for (String t : cond.substring(5).split("\\|")) {
+                    if (c.getType().hasCreatureType(t) || c.getType().hasSubtype(t)) {
+                        any = true;
+                    }
+                }
+                if (!any || !c.isCreature()) {
+                    return false;
+                }
+            } else if (cond.startsWith("mv<=")) {
+                if (c.getCMC() > num(cond.substring(4), 0)) {
+                    return false;
+                }
+            } else if (cond.startsWith("mv=")) {
+                if (c.getCMC() != num(cond.substring(3), 0)) {
+                    return false;
+                }
+            } else if ("artifact".equals(cond)) {
+                if (!c.isArtifact()) {
+                    return false;
+                }
+            } else if ("noncreatureartifact".equals(cond)) {
+                if (!c.isArtifact() || c.isCreature()) {
+                    return false;
+                }
+            } else if ("creature".equals(cond)) {
+                if (!c.isCreature()) {
+                    return false;
+                }
+            } else if ("colored".equals(cond)) {
+                if (c.getColor().isColorless()) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
