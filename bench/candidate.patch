+    private static Map<String, String[]> payoffs() {
+        Map<String, String[]> m = payoffs;
+        if (m != null) {
+            return m;
+        }
+        synchronized (ComboShortcut.class) {
+            if (payoffs != null) {
+                return payoffs;
+            }
