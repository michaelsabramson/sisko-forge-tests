+                ownedCards.add(c);
+                owned.add(c.getName());
+                final String n = c.getName();
+                final int split = n.indexOf(" // ");
+                if (split > 0) {
+                    owned.add(n.substring(0, split));
+                }
+                try {
+                    owned.add(c.getState(forge.card.CardStateName.Original).getName());
+                } catch (RuntimeException e) {
+                    // no original state
+                }
+            }
+        }
+        final List<Combo> mine = new ArrayList<>();
+        final List<Combo> engines = new ArrayList<>();
+        outer:
+        for (Combo combo : combos()) {
+            for (Piece piece : combo.pieces) {
+                if (piece.name.startsWith("#")) {
+                    boolean fits = false;
+                    for (Card c : ownedCards) {
+                        if (fitsTemplate(c, piece.name)) {
+                            fits = true;
+                            break;
+                        }
+                    }
+                    if (!fits) {
+                        continue outer;
+                    }
+                } else if (!owned.contains(piece.name)) {
+                    continue outer;
+                }
+            }
+            if (combo.kind.startsWith("engine:")) {
+                engines.add(combo);
+            } else {
+                mine.add(combo);
+            }
+        }
+        final Map<String, String[]> pay = payoffs();
+        int composed = 0;
+        for (Combo engine : engines) {
+            final String[] classes = engine.kind.substring(7).split(",");
+            for (Map.Entry<String, String[]> e : pay.entrySet()) {
+                if (!owned.contains(e.getKey()) || composed > 4000) {
+                    continue;
+                }
+                String matched = null;
+                for (String cls : classes) {
+                    if (("," + e.getValue()[0] + ",").contains("," + cls + ",")) {
+                        matched = cls;
+                        break;
+                    }
+                }
+                if (matched == null) {
+                    continue;
+                }
+                boolean already = false;
